# Literal detents: speed never changes steps, including through zero.
wait 300
expect view 7
spin K1 -100
expect par0 0
turn K1 100 10
expect par0 100
turn K1 -1 30
expect par0 99
wait 200
turn K1 -1 150
expect par0 98
# A different destination on the same encoder starts with a fine step.
tap GLO
wait 300
expect view 6
listen
turn K1 1 150
wait 300
said Tune +1
turn K1 -1 150
wait 300
said Tune 0
# First click immediately leaves zero; no three-click dead zone.
turn K1 -1 150
wait 300
said Tune -1
spin K1 5
wait 300
said Tune +4
expect par16 4
turn K1 -5 5
wait 300
said Tune -1
expect par16 -1
# Small discrete choices and navigators never accelerate.
tap HOME
wait 300
spin SELECT 2
turn ALGO 5 20
wait 300
expect par34 15
turn PRESET 3 20
wait 300
expect piece 3
