# T-WRECKS retires the decorative chord ring. The Home control table stays
# still while music advances; actual controls and Hold must still redraw.
wait 2500
expect playing 1
expect view 7
expect blits >0
wait 16000
expect blits 0
spin SELECT 1
wait 250
expect blits >0
wait 2500
expect blits >0
wait 5000
expect blits 0
tap REC
wait 250
expect frozen 1
expect blits >0
wait 2500
expect blits >0
wait 5000
expect blits 0
tap REC
wait 250
expect frozen 0
expect blits >0
shot static-home.png
